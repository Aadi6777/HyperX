# =============================================================================
# HyperX Environment Configuration
# =============================================================================

# =============================================================================
# Option A: Supabase Cloud PostgreSQL
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> JDBC / URI
# =============================================================================
# Direct Connection:
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<your-database-password>

# Or Connection Pooler (recommended for IPv4 networks):
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
# SPRING_DATASOURCE_PASSWORD=<your-database-password>

# =============================================================================
# Option B: Local PostgreSQL (Docker)
# =============================================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hyperx_db
SPRING_DATASOURCE_USERNAME=hyperx_user
SPRING_DATASOURCE_PASSWORD=hyperx_secure_pass_2026

# Spring Boot Backend Service
BACKEND_PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Frontend Web Client
FRONTEND_PORT=5173

# --- Frontend (Vite) variables: put these in frontend/.env (or your Vercel project settings) ---
# NOTE: the code reads VITE_API_BASE_URL. The old example said VITE_API_URL, which was ignored.
# Leave unset for local dev (the Vite proxy forwards /api and /ws to localhost:8080).
# Set it to your deployed backend/tunnel when the frontend is on Vercel - Vercel cannot host or
# proxy WebSockets, so without this the signaling socket has nowhere to connect.
# VITE_API_BASE_URL=https://your-backend.example.com
# Or point only the signaling socket somewhere explicit:
# VITE_SIGNALING_URL=wss://your-backend.example.com/ws/signaling

# TURN relay (needed when peers are on different networks / mobile data / strict firewalls).
# Without these the app falls back to a free public test relay, which is fine for trying it out
# but slow and unsuitable for production. Free tiers: Metered, Cloudflare Calls TURN, or run coturn.
# VITE_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:443?transport=tcp
# VITE_TURN_USERNAME=user
# VITE_TURN_CREDENTIAL=secret
# Or supply the complete list as JSON (overrides everything above):
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# Security (Phase 2 readiness)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
