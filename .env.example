# =============================================================================
# HyperX Environment Configuration
# =============================================================================

# =============================================================================
# Option A: Supabase Cloud PostgreSQL
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string
# =============================================================================
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<your-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?ssl=require

# =============================================================================
# Option B: Local PostgreSQL (Docker)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://hyperx_user:hyperx_secure_pass_2026@localhost:5432/hyperx_db

# Fallback SQLite local database URL (used automatically if PostgreSQL is unreachable)
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./hyperx_local.db

# Backend Service
BACKEND_PORT=8080
SERVER_PORT=8080
HOST=0.0.0.0

# Frontend Web Client
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080

# Security (JWT)
JWT_SECRET_KEY=hyperx-ultra-secure-jwt-secret-key-32-bytes-minimum-length-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080
