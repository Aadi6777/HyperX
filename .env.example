# =============================================================================
# Nexora Environment Configuration
# =============================================================================

# Server Port & Host
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Database (Optional: falls back to built-in resilient in-memory store if unset)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexora?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nexora

# JWT Authentication Secret (Set your own secure random 32+ character string)
JWT_SECRET=replace_with_your_own_secure_production_secret_key_minimum_32_chars

# Frontend (Vite) variables:
# When running full-stack on Render, leave unset for same-origin routing.
# For separate frontend hosting (e.g. Vercel), point to your live backend:
# VITE_API_BASE_URL=https://nexora.onrender.com
# VITE_SIGNALING_URL=wss://nexora.onrender.com/ws/signaling

# Custom STUN / TURN Relay Servers (Optional: overrides default STUN/TURN)
# VITE_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:443?transport=tcp
# VITE_TURN_USERNAME=user
# VITE_TURN_CREDENTIAL=secret
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
